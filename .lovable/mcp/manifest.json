{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "nairabay",
      "version": "0.1.0",
      "title": "nairabay"
    },
    "tools": [
      {
        "name": "search_listings",
        "title": "Search listings",
        "description": "Search active Nairabay listings by keyword, category, state or city.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Words to match in the listing title.",
              "type": "string",
              "maxLength": 100
            },
            "category": {
              "description": "Category name, e.g. Phones.",
              "type": "string",
              "maxLength": 50
            },
            "state": {
              "description": "Nigerian state, e.g. Lagos.",
              "type": "string",
              "maxLength": 50
            },
            "city": {
              "description": "City or area.",
              "type": "string",
              "maxLength": 50
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_listing",
        "title": "Get listing",
        "description": "Get details of one Nairabay listing, including the seller's Bay# and verification.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Listing ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_bay",
        "title": "Get seller Bay#",
        "description": "Get a seller's public Bay# page: verification status and their active listings.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "description": "Bay# handle, e.g. bay2342."
            }
          },
          "required": [
            "handle"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
